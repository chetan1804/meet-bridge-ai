# Global
APP_NAME=MeetBridge AI
APP_ENV=development

# Frontend
NEXT_PUBLIC_APP_NAME=MeetBridge AI
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend
API_PREFIX=/api
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
JWT_SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
POSTGRES_DB=meetbridge
POSTGRES_USER=meetbridge
POSTGRES_PASSWORD=meetbridge
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg2://meetbridge:meetbridge@127.0.0.1:5433/meetbridge

# Redis
REDIS_URL=redis://localhost:6379/0

# AI providers
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Security
ENABLE_AUDIO_RETENTION=false
AUDIO_RETENTION_DAYS=7
